<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Music Assistant Terminology">
    <suite name="Music Assistant Suite" code="MAsc"
           description="Playback commands and state for Music Assistant.">
        <enumeration name="EPlS" code="ePlS">
            <enumerator name="stopped" code="kPSS" description="Playback is stopped."/>
            <enumerator name="playing" code="kPSP" description="Playback is playing."/>
            <enumerator name="paused" code="kPSp" description="Playback is paused."/>
        </enumeration>

        <class name="application" code="capp" description="The Music Assistant application.">
            <property name="player state" code="pStt" type="EPlS" access="r"
                      description="Is playback playing, paused, or stopped?"/>
            <property name="sound volume" code="pVol" type="integer" access="rw"
                      description="The selected player's volume, from 0 to 100."/>
        </class>

        <command name="play" code="MAscMApl" description="Start or resume playback."/>
        <command name="pause" code="MAscMApa" description="Pause playback."/>
        <command name="playpause" code="MAscMApp"
                 description="Toggle between playing and paused."/>
        <command name="next track" code="MAscMAnx" description="Skip to the next track."/>
        <command name="previous track" code="MAscMApv"
                 description="Skip to the previous track."/>
        <command name="stop" code="MAscMAst" description="Stop playback."/>
        <command name="increase volume" code="MAscMAvi"
                 description="Increase the selected player's volume."/>
        <command name="decrease volume" code="MAscMAvd"
                 description="Decrease the selected player's volume."/>
    </suite>
</dictionary>

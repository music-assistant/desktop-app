{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher-capability",
  "description": "Permissions for the local server launcher window",
  "windows": ["launcher"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-is-companion-app",
    "allow-is-desktop-app",
    "allow-is-linux",
    "allow-is-macos",
    "allow-get-app-version",
    "allow-get-i18n-bundle",
    "allow-server-connecting",
    "allow-server-connect-failed",
    "allow-check-server-reachable",
    "allow-companion-ready",
    "allow-navigate-to-launcher",
    "allow-get-now-playing",
    "allow-update-now-playing",
    "allow-start-desktop-services",
    "allow-start-discord-rpc",
    "allow-start-rpc",
    "allow-discover-servers",
    "allow-get-settings",
    "allow-set-setting",
    "allow-set-string-setting",
    "allow-set-int-setting",
    "allow-list-audio-devices",
    "allow-stop-sendspin",
    "allow-restart-sendspin",
    "allow-get-sendspin-status",
    "allow-sendspin-command",
    "allow-get-sendspin-player-id",
    "allow-configure-sendspin"
  ],
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  }
}
